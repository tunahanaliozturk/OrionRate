<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>OrionRate.AspNetCore</PackageId>
    <Description>ASP.NET Core endpoint and route-group rate limiting backed by OrionRate.</Description>
    <PackageTags>orion;rate-limiting;aspnetcore;minimal-api;throttling</PackageTags>
    <RootNamespace>Moongazing.OrionRate.AspNetCore</RootNamespace>
    <PackageReadmeFile>docs/README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../Moongazing.OrionRate/Moongazing.OrionRate.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="docs/README.md" Pack="true" PackagePath="docs/" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Moongazing.OrionRate.Tests" />
  </ItemGroup>
</Project>
