<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      The NativeAOT publish smoke test. `dotnet publish` on this project must succeed with zero
      trim/AOT warnings, exercising the public surface (both algorithms via the limiter, the Key
      helper, and telemetry) in a rooted, trimmed, native binary that exits 0.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks />
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Moongazing.OrionRate\Moongazing.OrionRate.csproj" />
  </ItemGroup>
</Project>
